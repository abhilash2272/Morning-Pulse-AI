# ============================================================
# Morning Pulse AI — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/morning_pulse

# --- SEC EDGAR ---
# Must identify your application per SEC fair-access policy.
# Format: "AppName/Version contact@email.com"
SEC_USER_AGENT=MorningPulseAI/1.0 yourname@university.edu
SEC_REQUEST_DELAY=0.5

# --- GDELT ---
GDELT_MAX_RESULTS=100
GDELT_FETCH_ARTICLE_CONTENT=false

# --- Pipeline ---
DEFAULT_LOOKBACK_DAYS=7
USE_MOCK_DATA=false
ENABLE_SEMANTIC_DEDUP=false

# --- Logging ---
LOG_LEVEL=INFO

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
